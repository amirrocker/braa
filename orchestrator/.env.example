# Berisha & Rocker Agentic Automation - orchestrator environment template
# Copy to .env and fill in. Never commit the real .env (see .gitignore).
#
# This file only covers what ONE customer's Phase 1 pilot install needs.
# See ../Berisha_Rocker_Agentic_Automation_plan.md -> "Multi-tenant isolation
# model" for why production deployments need one of these per customer
# workspace, not one shared .env for everyone.

# --- Anthropic / Managed Agents ---
# Resolved by the SDK in this order: ANTHROPIC_API_KEY -> ANTHROPIC_AUTH_TOKEN
# -> `ant auth login` profile. Prefer `ant auth login` for local dev.
ANTHROPIC_API_KEY=

# Webhook signing secret from Console -> Manage -> Webhooks (whsec_... , shown once).
ANTHROPIC_WEBHOOK_SIGNING_KEY=

# --- Per-customer identity (parameterized, per the plan's "Parameterization" section) ---
BERA_CUSTOMER_ID=techkomp-electrical
BERA_BUSINESS_NAME=TechKomp Electrical

# --- Mail/Calendar MCP connector (Gmail / Google Workspace for this pilot) ---
# The hosted MCP server URL for Gmail and Google Calendar.
# UNVERIFIED — see plan.md Phase 0: confirm a production-grade Gmail/Google
# Calendar MCP server actually exists before relying on this.
BERA_MAIL_MCP_URL=
BERA_CALENDAR_MCP_URL=

# OAuth credential material for the vault (see provisioning.py::create_customer_vault).
# Obtained via Google's own OAuth 2.0 flow (accounts.google.com / oauth2.googleapis.com
# token endpoint) — never entered by an agent or by Claude.
BERA_MAIL_OAUTH_ACCESS_TOKEN=
BERA_MAIL_OAUTH_REFRESH_TOKEN=
BERA_MAIL_OAUTH_CLIENT_ID=
BERA_MAIL_OAUTH_TOKEN_ENDPOINT=
BERA_CALENDAR_OAUTH_ACCESS_TOKEN=
BERA_CALENDAR_OAUTH_REFRESH_TOKEN=
BERA_CALENDAR_OAUTH_CLIENT_ID=
BERA_CALENDAR_OAUTH_TOKEN_ENDPOINT=

# --- Telegram (kept OUTSIDE the agent loop entirely — see plan.md
# "Telegram delivery - kept outside the agent loop, deliberately") ---
# Each customer creates their OWN bot via BotFather. Never a shared bot.
BERA_TELEGRAM_BOT_TOKEN=
BERA_TELEGRAM_CHAT_ID=

# --- Schedule ---
BERA_DIGEST_TIME=09:00
BERA_TIMEZONE=Europe/Berlin

# --- Check parameters (defaults match plan.md's config schema) ---
BERA_EMAIL_CRITERIA=unread
BERA_EMAIL_LOOKBACK_HOURS=2
BERA_CALENDAR_WINDOW_DAYS=7

# --- Webhook server ---
BERA_WEBHOOK_PORT=8080

# --- Where provisioned resource IDs get persisted after setup ---
# (agent IDs, environment ID, vault ID, deployment IDs — see provisioning.py)
BERA_STATE_FILE=./state/techkomp-electrical.json
